{
  "rewrites": [
    {
      "source": "/ask.html",
      "destination": "/api/ask"
    },
    {
      "source": "/ask/:username",
      "destination": "/api/ask?user=:username"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "X-XSS-Protection",
          "value": "1; mode=block"
        }
      ]
    }
  ]
}
